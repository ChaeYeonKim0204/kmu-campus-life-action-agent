# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git에 올리지 않음)
# 키가 없으면 해당 노드는 자동으로 모의(mock)/콘솔 모드로 폴백하므로,
# 아무 키 없이도 `python main.py` 데모는 끝까지 동작합니다.

# --- LLM (맥락 분석 analyzer.py) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini          # 팀 키는 gpt-5-mini 권장

# --- Telegram (Human-in-the-Loop 승인 executor.py) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AUTO_APPROVE=                     # 1 이면 텔레그램/콘솔 입력 없이 자동 승인(데모용)

# --- Notion (executor.py 칸반 티켓) ---
NOTION_TOKEN=
NOTION_DATABASE_ID=

# --- Google Calendar (일정 검증 validator.py / 등록 executor.py) ---
# OAuth 토큰 파일(token.json) 경로. 없으면 모의 Busy 데이터로 검증.
GOOGLE_TOKEN_PATH=token.json
WEEKLY_PRODUCTIVE_HOURS=70        # 한 주 생산 가능 총 시간(검증 기준치)

# --- 데모 옵션 ---
TRACE_JSON=                       # 1 이면 노드 트레이스를 stderr에 NDJSON으로도 방출
